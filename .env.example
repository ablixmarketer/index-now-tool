# Server credentials for the single site configured by this deployment.
# Never commit a real .env file or real API keys.
INDEXNOW_KEY=your-indexnow-key-here
INDEXNOW_KEY_LOCATION=https://yourdomain.com
BING_SUBMISSION_API_KEY=your-bing-api-key-here

# Optional: use a separate backend from a separately deployed frontend.
# Leave empty for a combined Render deployment that serves the API from the same origin.
VITE_API_BASE_URL=

NODE_ENV=development
API_PORT=3001
