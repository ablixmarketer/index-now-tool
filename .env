# ============================================
# MULTI-SITE CONFIGURATION
# ============================================
# This tool supports multiple sites with individual API keys.
# Configure your primary site using these environment variables.
# Additional sites can be added through the Site Selector UI.

# Primary Site - IndexNow Configuration
# Generate your key from: https://www.indexnow.org/
INDEXNOW_KEY=558e9f294e5246d2993e4eaed06e54b4
INDEXNOW_KEY_LOCATION=https://www.airi.health

# Primary Site - Bing Submission API Configuration
# Get your Bing API key from: https://www.bing.com/webmasters/
# This is optional - you can use IndexNow alone if preferred
BING_SUBMISSION_API_KEY=

# ============================================
# DEPLOYMENT & DEVELOPMENT SETTINGS
# ============================================
NODE_ENV=development
API_PORT=3001

# ============================================
# EXAMPLE: Additional Sites Configuration
# ============================================
# To add more sites, use the Site Selector UI in the application.
# Each site stores its own:
# - Domain/Display Name
# - IndexNow Key
# - Bing Submission Key
#
# Sites are managed in browser localStorage and persist across sessions.
# This allows you to work with multiple websites without redeploying.

# Optional: Custom search engine endpoints
# BING_ENDPOINT=https://api.indexnow.org/indexnow
# YANDEX_ENDPOINT=https://yandex.com/indexnow
